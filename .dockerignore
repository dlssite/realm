# ── Docker build context exclusions ──────────────────────────────────────────
# Keeps the build context lean and prevents stale artifacts from
# poisoning the Docker build cache.

# Dependencies — reinstalled inside the image
node_modules/
.pnpm-store/

# Build outputs — rebuilt inside the image; must NOT be copied in
dist/
build/

# TypeScript incremental build info.
# If copied into the builder, tsc --build reads it, thinks sources are
# up-to-date, and skips emission — leaving dist/ empty inside Docker.
*.tsbuildinfo

# Turbo cache — not needed inside Docker
.turbo/

# Environment files — injected at runtime, never baked into the image
.env
.env.local
.env.production

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Git metadata
.git/
.gitignore

# Local dev docs (no effect on build, just noise)
docs/
*.md
