# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Install pnpm + openssl (required by Prisma engine)
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Copy workspace manifests first (layer cache optimisation)
COPY pnpm-workspace.yaml ./
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY turbo.json ./
COPY tsconfig.base.json ./

# Copy all package manifests before source so dep installs are cached
COPY packages/types/package.json      ./packages/types/
COPY packages/utils/package.json      ./packages/utils/
COPY packages/config/package.json     ./packages/config/
COPY packages/ui/package.json         ./packages/ui/
COPY packages/sdk/package.json        ./packages/sdk/
COPY apps/api/package.json            ./apps/api/

# Install all dependencies (workspace-aware)
RUN pnpm install --frozen-lockfile

# Copy full packages source and build them so dist/ exists before API build
COPY packages ./packages
# Remove any stale incremental build info that may have been copied from the
# host — if present, tsc --build would skip emission thinking nothing changed,
# resulting in empty dist/ folders in the final image.
RUN find /app/packages -name "*.tsbuildinfo" -delete
RUN pnpm --filter @realm/types build
RUN pnpm --filter @realm/utils build
RUN pnpm --filter @realm/config build
RUN pnpm --filter @realm/sdk build

# Copy prisma fragments + merge script
COPY prisma ./prisma
COPY scripts/merge-prisma.js ./scripts/merge-prisma.js

# Merge all prisma/schema/*.prisma → prisma/schema.prisma
RUN node ./scripts/merge-prisma.js

# Generate Prisma client from the merged schema
RUN pnpm exec prisma generate --schema prisma/schema.prisma

# Copy API source and build
COPY apps/api ./apps/api
RUN pnpm --filter @realm/api exec tsc

# ── Stage 2: Production image ─────────────────────────────────────────────────
FROM node:20-alpine AS runner

# Install openssl — required by Prisma query engine at runtime
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Copy workspace manifests for prod install
COPY pnpm-workspace.yaml ./
COPY package.json ./
COPY pnpm-lock.yaml ./

COPY packages/types/package.json      ./packages/types/
COPY packages/utils/package.json      ./packages/utils/
COPY packages/config/package.json     ./packages/config/
COPY packages/ui/package.json         ./packages/ui/
COPY packages/sdk/package.json        ./packages/sdk/
COPY apps/api/package.json            ./apps/api/

# Production deps only
RUN pnpm install --frozen-lockfile --prod

# Copy compiled API output
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy compiled workspace packages (built dist/ folders)
COPY --from=builder /app/packages/types/dist  ./packages/types/dist
COPY --from=builder /app/packages/utils/dist  ./packages/utils/dist
COPY --from=builder /app/packages/config/dist ./packages/config/dist
COPY --from=builder /app/packages/sdk/dist    ./packages/sdk/dist

# Copy prisma CLI + engines from builder (devDep, not in prod install)
COPY --from=builder /app/node_modules/.bin/prisma         ./node_modules/.bin/prisma
COPY --from=builder /app/node_modules/prisma              ./node_modules/prisma
COPY --from=builder /app/node_modules/.pnpm/prisma@5.17.0 ./node_modules/.pnpm/prisma@5.17.0

# Copy the generated Prisma client from builder
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@5.17.0_prisma@5.17.0 \
     ./node_modules/.pnpm/@prisma+client@5.17.0_prisma@5.17.0

# Copy Prisma engines (query/migration binaries)
COPY --from=builder /app/node_modules/.pnpm/@prisma+engines@5.17.0 \
     ./node_modules/.pnpm/@prisma+engines@5.17.0

# Copy merged schema + migrations (needed for migrate deploy at startup)
COPY --from=builder /app/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=builder /app/prisma/migrations    ./prisma/migrations

EXPOSE 4000

# Run migrations then start the server
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy --schema=/app/prisma/schema.prisma && node apps/api/dist/main.js"]
