# Server Configuration
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://realm:password@localhost:5432/realm

# Authentication (Better Auth)
SESSION_SECRET=change-this-to-a-secure-random-64-character-string-in-production
BETTER_AUTH_SECRET=change-this-to-a-secure-random-64-character-string-in-production

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=realm-files
MINIO_USE_SSL=false
# Public-facing base URL rewritten into presigned URLs returned to the browser.
# Required when MinIO runs on an internal hostname (e.g. Docker service name)
# or when the app is served over HTTPS (mixed-content blocks plain http://).
# Leave unset to use the raw MINIO_ENDPOINT:MINIO_PORT URL (local dev only).
# Example (separate MinIO domain): https://minio.example.com
# Example (proxy via main domain): https://app.example.com/storage
MINIO_PUBLIC_URL=

# AI Provider Configuration
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=

# Frontend Configuration
VITE_API_URL=http://localhost:4000
VITE_APP_URL=http://localhost:3000
