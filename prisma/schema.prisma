  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskDependency {
  blockingTaskId String @map("blocking_task_id") @db.Uuid
  blockedTaskId  String @map("blocked_task_id") @db.Uuid

  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@id([blockingTaskId, blockedTaskId])
  @@map("task_dependencies")
}

// --- wiki.prisma ---
// Wiki module schema: pages, versions, templates

enum WikiVisibility {
  WORKSPACE
  TEAM
  PROJECT
  ROLE

  @@map("wiki_visibility")
}

model WikiPage {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  workspaceId     String             @map("workspace_id") @db.Uuid
  createdById     String             @map("created_by_id") @db.Uuid
  parentId        String?            @map("parent_id") @db.Uuid
  teamId          String?            @map("team_id") @db.Uuid
  projectId       String?            @map("project_id") @db.Uuid

  title           String             @db.VarChar(255)
  slug            String             @db.VarChar(255)
  isPublished     Boolean            @default(false) @map("is_published")
  latestVersionId String?            @map("latest_version_id") @db.Uuid
  visibility      WikiVisibility     @default(WORKSPACE)

  // Relations
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  createdBy       User               @relation(fields: [createdById], references: [id])
  parent          WikiPage?          @relation("PageChildren", fields: [parentId], references: [id])
  children        WikiPage[]         @relation("PageChildren")
  team            Team?              @relation(fields: [teamId], references: [id])
  project         Project?           @relation(fields: [projectId], references: [id])
  versions        WikiPageVersion[]

  visibilityRole  WorkspaceRole?     @map("visibility_role")

  @@index([workspaceId])
  @@index([parentId])
  @@index([teamId])
  @@index([projectId])
  @@map("wiki_pages")
}

model WikiPageVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String   @map("created_by_id") @db.Uuid
  pageId        String   @map("page_id") @db.Uuid

  title         String   @db.VarChar(255)
  content       Json?
  versionNumber Int      @map("version_number")
  changeSummary String?  @db.Text @map("change_summary")

  // Relations
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([pageId])
  @@map("wiki_page_versions")
}

model WikiTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid

  name        String   @db.VarChar(255)
  description String?  @db.Text
  content     Json?

  // Relations
  workspace  Workspace @relation(fields: [workspaceId], references: [id])
  createdBy  User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("wiki_templates")
}

// --- workspace.prisma ---
model Workspace {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String    @map("created_by_id") @db.Uuid

  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(100)
  logoUrl     String?   @map("logo_url") @db.VarChar(512)

  // Relations
  createdBy User              @relation("CreatedWorkspaces", fields: [createdById], references: [id])
  members   WorkspaceMember[]
  teams     Team[]
  projects  Project[]
  tasks     Task[]
  labels    Label[]
  // Wiki relations
  wikiPages    WikiPage[]
  wikiTemplates WikiTemplate[]
  invitations  Invitation[]

  // AI relations
  aiProviderConfig AiProviderConfig?
  aiConversations  AiConversation[]
  // Chat relations
  channels         Channel[]
  // Files relations
  fileRecords      FileRecord[]
  // Calendar relations
  calendarEvents   CalendarEvent[]
  // Activity / Audit Log relations
  auditLogs        AuditLog[]

  @@index([slug])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Team {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspaceId String    @map("workspace_id") @db.Uuid
  leaderId    String?   @map("leader_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leader    User?       @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members   TeamMember[]
  projects  Project[]
  channels  Channel[]
  wikiPages  WikiPage[]
  calendarEvents CalendarEvent[]
  fileRecords    FileRecord[]

  @@index([workspaceId])
  @@index([leaderId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Invitation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")
  workspaceId String   @map("workspace_id") @db.Uuid
  email       String   @db.VarChar(255)
  token       String   @unique @db.VarChar(255)
  role        WorkspaceRole @default(MEMBER)
  acceptedAt  DateTime? @map("accepted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@map("invitations")
}

