model Workspace {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String    @map("created_by_id") @db.Uuid

  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(100)
  logoUrl     String?   @map("logo_url") @db.VarChar(512)

  // Relations
  createdBy User              @relation("CreatedWorkspaces", fields: [createdById], references: [id])
  members   WorkspaceMember[]
  teams     Team[]
  projects  Project[]
  tasks     Task[]
  labels    Label[]
  // Wiki relations
  wikiPages    WikiPage[]
  wikiTemplates WikiTemplate[]
  invitations  Invitation[]

  // AI relations
  aiProviderConfig AiProviderConfig?
  aiConversations  AiConversation[]
  // Chat relations
  channels         Channel[]
  // Files relations
  fileRecords      FileRecord[]
  // Calendar relations
  calendarEvents   CalendarEvent[]
  // Activity / Audit Log relations
  auditLogs        AuditLog[]

  @@index([slug])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Team {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspaceId String    @map("workspace_id") @db.Uuid
  leaderId    String?   @map("leader_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leader    User?       @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members   TeamMember[]
  projects  Project[]
  channels  Channel[]
  wikiPages  WikiPage[]
  calendarEvents CalendarEvent[]
  fileRecords    FileRecord[]

  @@index([workspaceId])
  @@index([leaderId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Invitation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")
  workspaceId String   @map("workspace_id") @db.Uuid
  email       String   @db.VarChar(255)
  token       String   @unique @db.VarChar(255)
  role        WorkspaceRole @default(MEMBER)
  acceptedAt  DateTime? @map("accepted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@map("invitations")
}
